{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "tutorial.json - 10 langkah + starterGrant + sasaran starter berskrip",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "dataVersion",
    "steps",
    "starterGrant",
    "starterTarget"
  ],
  "properties": {
    "dataVersion": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "steps": {
      "type": "array",
      "minItems": 10,
      "maxItems": 10,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "step",
          "id",
          "titleKey",
          "descKey",
          "uiElement",
          "requiredAction"
        ],
        "properties": {
          "step": {
            "type": "integer",
            "minimum": 1,
            "maximum": 10
          },
          "id": {
            "type": "string",
            "pattern": "^tu_step_[0-9]{2}$"
          },
          "titleKey": {
            "type": "string",
            "pattern": "^tu\\.[a-z0-9_]+\\.title$"
          },
          "descKey": {
            "type": "string",
            "pattern": "^tu\\.[a-z0-9_]+\\.desc$"
          },
          "uiElement": {
            "type": "string",
            "pattern": "^[a-z0-9_]+$"
          },
          "requiredAction": {
            "type": "string",
            "pattern": "^[a-z0-9_]+$"
          },
          "rewardTM": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    },
    "starterGrant": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tm"
      ],
      "properties": {
        "tm": {
          "type": "integer",
          "minimum": 1000
        },
        "noteKey": {
          "type": "string",
          "pattern": "^tu\\.starter\\.note$"
        }
      }
    },
    "starterTarget": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "special",
        "featuredTier",
        "maxStartPriceTM",
        "noAiBidsMinutes",
        "firstPurchaseWithinMinutes"
      ],
      "properties": {
        "special": {
          "type": "boolean",
          "const": true
        },
        "featuredTier": {
          "type": "integer",
          "const": 1
        },
        "maxStartPriceTM": {
          "type": "integer",
          "minimum": 1000
        },
        "noAiBidsMinutes": {
          "type": "integer",
          "const": 8
        },
        "firstPurchaseWithinMinutes": {
          "type": "integer",
          "const": 8
        },
        "noteKey": {
          "type": "string",
          "pattern": "^tu\\.starter\\.note$"
        }
      }
    }
  }
}
