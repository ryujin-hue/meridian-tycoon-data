{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ai_ceos.json - 7 profil CEO AI",
  "type": "object",
  "required": [
    "dataVersion",
    "ceos"
  ],
  "properties": {
    "dataVersion": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "ceos": {
      "type": "array",
      "minItems": 7,
      "maxItems": 7,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "nameKey",
          "profile",
          "aggression",
          "maxPremiumOverNT",
          "bidIncrementPct",
          "entryDelayMinutes",
          "favoriteSectors",
          "tierSpeed",
          "bioKey",
          "auctionBoss"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^ceo_[a-z0-9_]+$"
          },
          "nameKey": {
            "type": "string",
            "pattern": "^ceo\\.[a-z0-9_.]+\\.name$"
          },
          "profile": {
            "type": "string",
            "enum": [
              "agresif",
              "kalkulatif",
              "opportunis",
              "pesimis"
            ]
          },
          "aggression": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "maxPremiumOverNT": {
            "type": "number",
            "minimum": 0,
            "maximum": 0.4
          },
          "bidIncrementPct": {
            "type": "number",
            "minimum": 1,
            "maximum": 10
          },
          "entryDelayMinutes": {
            "type": "integer",
            "minimum": 0,
            "maximum": 180
          },
          "favoriteSectors": {
            "type": "array",
            "minItems": 1,
            "maxItems": 3,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "enum": [
                "app",
                "fnb",
                "logistics"
              ]
            }
          },
          "tierSpeed": {
            "type": "string",
            "enum": [
              "slow",
              "steady",
              "fast"
            ]
          },
          "bioKey": {
            "type": "string",
            "pattern": "^ceo\\.[a-z0-9_.]+\\.bio$"
          },
          "auctionBoss": {
            "type": "boolean"
          }
        }
      }
    }
  },
  "additionalProperties": false
}
