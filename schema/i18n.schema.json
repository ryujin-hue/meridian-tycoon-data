{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "i18n/*.json - jadual string berkunci (en, ms, id)",
  "type": "object",
  "additionalProperties": false,
  "required": ["dataVersion", "lang", "strings"],
  "properties": {
    "dataVersion": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "lang": { "type": "string", "enum": ["en", "ms", "id"] },
    "strings": {
      "type": "object",
      "minProperties": 1200,
      "propertyNames": { "pattern": "^[a-z][a-z0-9_]*(\\.[a-z0-9_]+)+$" },
      "additionalProperties": { "type": "string", "minLength": 1 }
    }
  }
}
