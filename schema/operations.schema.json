{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "operations.json - 24 operasi (3 sektor x 8 jenis)",
  "type": "object",
  "required": [
    "dataVersion",
    "operations"
  ],
  "properties": {
    "dataVersion": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "operations": {
      "type": "array",
      "minItems": 24,
      "maxItems": 24,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "sector",
          "unlockTier",
          "nameKey",
          "descKey",
          "baseCost",
          "costGrowth",
          "baseIncomePerHour",
          "incomeGrowthPerLevel",
          "maxLevel"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^op_(app|fnb|logistics)_[1-8]$"
          },
          "sector": {
            "type": "string",
            "enum": [
              "app",
              "fnb",
              "logistics"
            ]
          },
          "unlockTier": {
            "type": "integer",
            "minimum": 1,
            "maximum": 8
          },
          "nameKey": {
            "type": "string",
            "pattern": "^op\\.[a-z0-9_.]+\\.name$"
          },
          "descKey": {
            "type": "string",
            "pattern": "^op\\.[a-z0-9_.]+\\.desc$"
          },
          "baseCost": {
            "type": "integer",
            "minimum": 100
          },
          "costGrowth": {
            "type": "number",
            "const": 1.15
          },
          "baseIncomePerHour": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "incomeGrowthPerLevel": {
            "type": "number",
            "minimum": 1.08,
            "maximum": 1.14
          },
          "maxLevel": {
            "type": "integer",
            "const": 10
          }
        }
      }
    }
  },
  "additionalProperties": false
}
