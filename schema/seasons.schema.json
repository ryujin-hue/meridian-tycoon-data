{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "seasons.json - 6 musim x 6 minggu",
  "type": "object",
  "required": [
    "dataVersion",
    "seasons"
  ],
  "properties": {
    "dataVersion": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "seasons": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "nameKey",
          "descKey",
          "weeksPerSeason",
          "seasonMultiplier",
          "freeTrack",
          "premiumTrack"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^sn_[1-6]$"
          },
          "nameKey": {
            "type": "string",
            "pattern": "^sn\\.[a-z0-9_]+\\.name$"
          },
          "descKey": {
            "type": "string",
            "pattern": "^sn\\.[a-z0-9_]+\\.desc$"
          },
          "weeksPerSeason": {
            "type": "integer",
            "const": 6
          },
          "seasonMultiplier": {
            "type": "number",
            "minimum": 0.95,
            "maximum": 1.25
          },
          "freeTrack": {
            "$ref": "#/definitions/track"
          },
          "premiumTrack": {
            "$ref": "#/definitions/track"
          }
        }
      }
    }
  },
  "definitions": {
    "track": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "steps"
      ],
      "properties": {
        "steps": {
          "type": "array",
          "minItems": 20,
          "maxItems": 20,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "step",
              "rewards"
            ],
            "properties": {
              "step": {
                "type": "integer",
                "minimum": 1,
                "maximum": 20
              },
              "rewards": {
                "type": "array",
                "minItems": 1,
                "maxItems": 2,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "type"
                  ],
                  "properties": {
                    "type": {
                      "type": "string",
                      "enum": [
                        "tm",
                        "dp",
                        "km",
                        "cosmetic",
                        "comfort"
                      ]
                    },
                    "amount": {
                      "type": "integer",
                      "minimum": 1
                    },
                    "ref": {
                      "type": "string",
                      "pattern": "^(cs_[a-z0-9_]+|auto_collect_daily|market_wishlist)$"
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "additionalProperties": false
}
